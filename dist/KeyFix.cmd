@echo off
rem =========================================================================
rem  KeyFix - disable a stuck keyboard key (registry Scancode Map).
rem  Single file, nothing to install. Asks for administrator rights itself.
rem  ASCII only on purpose; the Ukrainian UI text is base64 below (UTF-8).
rem  https://github.com/sgmnl2/keyfix
rem =========================================================================
setlocal
set "B64=%TEMP%\thkeyfix.b64"
set "TARGET=%PUBLIC%\TechHub_KeyFix.ps1"
(echo )>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
(echo )>>"%B64%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes($env:TARGET,[Convert]::FromBase64String(-join ([IO.File]::ReadAllLines($env:B64))))"
if not exist "%TARGET%" (
  echo.
  echo Could not unpack the tool. Antivirus may have blocked it.
  echo.
  pause
  goto cleanup
)
net session >nul 2>&1
if "%errorlevel%"=="0" (
  powershell -NoProfile -ExecutionPolicy Bypass -STA -File "%TARGET%"
) else (
  powershell -NoProfile -Command "Start-Process powershell -Verb RunAs -Wait -ArgumentList '-STA','-NoProfile','-ExecutionPolicy','Bypass','-File','%TARGET%'"
)
:cleanup
powershell -NoProfile -Command "foreach($p in @($env:TARGET,$env:B64)){ if($p -and (Test-Path -LiteralPath $p)){ [IO.File]::Delete($p) } }"
exit
